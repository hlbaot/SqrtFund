NEXT_PUBLIC_CHAIN_ID=43113
NEXT_PUBLIC_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
# Optional second Fuji RPC; public URL only, no secret credentials.
NEXT_PUBLIC_RPC_URL_FALLBACK=
NEXT_PUBLIC_EXPLORER_URL=https://testnet.snowtrace.io
NEXT_PUBLIC_STUDENT_REGISTRY_ADDRESS=0xbA0b756Ac2830743Cc56Fb42E504ED4d374Fe58e
NEXT_PUBLIC_FACTORY_ADDRESS=0xB2A91fd342d4C81061A97C42A789253d2252D85E
NEXT_PUBLIC_USDC_ADDRESS=0xFf56491e29085043DbB11cd01D54cC1449A3d686

# Blank values below are placeholders: fill locally. Server secrets never use NEXT_PUBLIC_.
ATTESTER_PRIVATE_KEY=
OTP_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Required for Student verification: comma-separated approved EXACT email domains.
# Blank/invalid configuration disables verification. Subdomains must be listed explicitly.
# Domain ownership + OTP does not establish current enrollment; approve student namespaces with the institution.
ALLOWED_EMAIL_DOMAINS=
# Optional: comma-separated domains to deny (including subdomains); takes precedence over allowlist.
BLOCKED_EMAIL_DOMAINS=

# Cloudinary: lưu trữ hình ảnh dự án
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# Legacy only: SF-03 uses signed uploads; disable old unsigned presets in Cloudinary.
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_API_KEY=
# Server-only secret required for project image uploads. Never prefix with NEXT_PUBLIC_.
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# Socket.IO: browser kết nối service riêng; Next/Vercel gọi /publish bằng secret.
NEXT_PUBLIC_SOCKET_URL=
SOCKET_SERVER_URL=
SOCKET_PUBLISH_SECRET=
# Chỉ đặt tại service Socket.IO. Origin chính xác, không có dấu / ở cuối.
SOCKET_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3015,https://www.sqrtfund.tech,https://sqrtfund.tech
SOCKET_PORT=3002

# Keeper chốt Round sau endTime + 24h. Ví riêng có AVAX Fuji trả gas, không cần quyền admin.
# Chỉ đặt key tại máy/service chạy keeper hoặc GitHub Actions secret; không dùng NEXT_PUBLIC_.
KEEPER_PRIVATE_KEY=
KEEPER_RPC_URL=
KEEPER_INTERVAL_MS=60000
KEEPER_MAX_GAS=2500000
KEEPER_MAX_GAS_PRICE_GWEI=100
# Only needed for EMAIL_PROVIDER=resend; SMTP_FROM must use your verified domain.
RESEND_API_KEY=
# Public attester address for Foundry deployment scripts (not its private key).
ATTESTER_ADDRESS=

# Optional tests: use a separate Supabase DEV project, never production.
RUN_VERIFICATION_INTEGRATION=0
SUPABASE_TEST_URL=
SUPABASE_TEST_SERVICE_ROLE_KEY=
