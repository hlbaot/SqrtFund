NEXT_PUBLIC_CHAIN_ID=43113
NEXT_PUBLIC_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
NEXT_PUBLIC_EXPLORER_URL=https://testnet.snowtrace.io
NEXT_PUBLIC_STUDENT_REGISTRY_ADDRESS=
NEXT_PUBLIC_FACTORY_ADDRESS=
NEXT_PUBLIC_USDC_ADDRESS=

# Blank values below are placeholders: fill locally. Server secrets never use NEXT_PUBLIC_.
ATTESTER_PRIVATE_KEY=
OTP_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Optional: để trống = chấp nhận mọi .edu/.edu.vn; có giá trị = chỉ domain trong danh sách và subdomain.
ALLOWED_EMAIL_DOMAINS=
# Optional: comma-separated domains to deny (including subdomains); takes precedence over allowlist.
BLOCKED_EMAIL_DOMAINS=
# Only needed for EMAIL_PROVIDER=resend; SMTP_FROM must use your verified domain.
RESEND_API_KEY=
# Public attester address for Foundry deployment scripts (not its private key).
ATTESTER_ADDRESS=

# Optional tests: use a separate Supabase DEV project, never production.
RUN_VERIFICATION_INTEGRATION=0
SUPABASE_TEST_URL=
SUPABASE_TEST_SERVICE_ROLE_KEY=

# Existing shared registry passed to DeployFactory (reuse it; do not redeploy per round).
STUDENT_REGISTRY_ADDRESS=
